# ---------------------------------------------------------------------------
# Server configuration. Copy this file to `server/.env` and fill in values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional extra browser origins allowed to call the API (comma separated).
# Useful for Vercel preview URLs; production values must use HTTPS.
CLIENT_URLS=

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# --- Administrator bootstrap (used only by `npm run seed`) -----------------
# There is no public registration. The seed script creates the single admin
# account from these values. Use a long, unique password.
ADMIN_NAME=Hailemariam
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password

# --- Authentication ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=portfolio_admin_token

# --- Image / PDF storage (Cloudinary) --------------------------------------
# When these are set, uploads go to Cloudinary and only URLs are stored in
# MongoDB. When empty, files are written to server/uploads (local dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# --- Contact form email notifications (optional) ---------------------------
# Leave SMTP_HOST empty to disable email. Messages are always saved to MongoDB.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@example.com>"
CONTACT_NOTIFY_EMAIL=admin@example.com
